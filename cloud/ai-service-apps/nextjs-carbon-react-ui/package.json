{
  "name": "nextjs-carbon-react-ui",
  "version": "0.1.0",
  "private": true,
  "repository": "git@github.ibm.com:dap/demo-gen-ai-flow-app.git",
  "bugs": "https://github.ibm.com/dap/demo-gen-ai-flow-app/issues",
  "license": "IBM",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{js,md,scss}\"",
    "format:diff": "prettier --list-different \"**/*.{js,md,scss}\""
  },
  "dependencies": {
    "@lexical/react": "^0.28.0",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.3",
    "lexical": "^0.28.0",
    "next": "^16.3.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@carbon/colors": "^11.58.0",
    "@carbon/feature-flags": "^1.9.0",
    "@carbon/icons-react": "^11.88.0",
    "@carbon/layout": "^11.59.0",
    "@carbon/react": "^1.116.0",
    "@carbon/styles": "^1.115.0",
    "@carbon/themes": "^11.81.0",
    "@carbon/type": "^11.67.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "7.5.0",
    "@eslint/eslintrc": "^3",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@types/node": "^20",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "husky": "1.3.1",
    "lint-staged": "^17.5.1",
    "lodash": "^4.17.21",
    "prettier": "^3.5.3",
    "sass": "^1.104.1",
    "showdown": "2.1.0",
    "typescript": "^5"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -e $HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.js": [
      "prettier --cache --write",
      "git add"
    ],
    "*.{scss,css}": [
      "prettier --cache --write",
      "git add"
    ],
    "*.md": [
      "prettier --cache --write",
      "git add"
    ]
  },
  "prettier": {
    "jsxBracketSameLine": true,
    "printWidth": 100,
    "singleQuote": false,
    "trailingComma": "es5"
  },
  "overrides": {
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4"
  }
}
